# Neo4j Configuration
NEO4J_URI=bolt://host.docker.internal:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=yourpassword

# Analyzer (docker-compose variable substitution)
# Point this at the directory containing your repo(s)
WORKSPACE_PATH=/path/to/your/workspace
# Optional: override the config file mounted into the container
PROJECTS_CONFIG_PATH=./projects.example.json

# MongoDB Configuration
MONGO_URI=mongodb+srv://<YOURUSER>:<YOURPASSWORD>@<YOURATLASURL>.mongodb.net/?retryWrites=true&w=majority&appName=<YOURAPPNAME>&InsecureSkipVerify=true
MONGO_DATABASE=<YOURDATABASE>
